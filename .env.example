# Copia este archivo como .env.local y rellena los valores.
# Sin las variables de Supabase la web funciona en "modo sin backend":
# formularios y reservas se envían por WhatsApp y el asistente usa las FAQ.

# URL pública de la web (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Settings → API Keys). Nunca pongas aquí la secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
